{% extends 'base.html' %}
{% block content %}
  <div class="container mt-4">
    <h2>Lista de Ítems</h2>
    <a href="/agregar" class="btn btn-success mb-3">Agregar nuevo ítem</a>
    <table class="table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            <td>{{ item.name }}</td>
            <td>{{ item.description }}</td>
            <td>
              <a href="/editar/{{ item.id }}" class="btn btn-warning btn-sm">Editar</a>
              <a href="/eliminar/{{ item.id }}" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
